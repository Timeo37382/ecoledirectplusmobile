{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "regions": ["cdg1"],
    "functions": {
        "api/proxy.js": {
            "maxDuration": 30
        },
        "api/prefs.js": {
            "maxDuration": 15
        }
    },
    "rewrites": [
        {
            "source": "/edp-api/(.*)",
            "destination": "/api/proxy?edpPath=$1"
        },
        {
            "source": "/edp-prefs",
            "destination": "/api/prefs"
        },
        {
            "source": "/((?!api/|edp-api/|edp-prefs).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/edp-api/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "no-store" }
            ]
        },
        {
            "source": "/edp-prefs",
            "headers": [
                { "key": "Cache-Control", "value": "no-store" }
            ]
        }
    ]
}
